type crosvm_exec, system_file_type, exec_type, file_type;
type crosvm_domain_tmpfs, file_type;

# Let crosvm open VM manager devices such as /dev/kvm.
allow crosvm_domain vm_manager_device_type:chr_file rw_file_perms;

# Most other domains shouldn't access /dev/kvm.
neverallow { domain -crosvm_domain -ueventd -shell } kvm_device:chr_file getattr;
neverallow { domain -crosvm_domain -ueventd } kvm_device:chr_file ~getattr;
neverallowxperm { domain -crosvm_domain } kvm_device:chr_file ioctl ~{ KVM_CHECK_EXTENSION };

# Most other domains shouldn't access other vm managers either.
# These restrictions need to be slightly looser than for kvm_device to allow
# for different implementations.
neverallow { coredomain appdomain -crosvm_domain -ueventd -shell } vm_manager_device_type:chr_file getattr;
neverallow { coredomain appdomain -crosvm_domain -ueventd } vm_manager_device_type:chr_file ~getattr;

# Let crosvm create temporary files.
tmpfs_domain(crosvm_domain)

# Let crosvm receive file descriptors from VirtualizationService.
allow crosvm_domain {
  virtualizationmanager_domain
  virtualizationservice
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `early_virtmgr_domain')
}:fd use;

# Allow sending VirtualizationService the failure reason and console/log from the VM via pipe.
allow crosvm_domain {
  virtualizationmanager_domain
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `early_virtmgr_domain')
}:fifo_file write;

# Let crosvm read the composite disk images (virtualizationservice_data_file), APEXes
# (staging_data_file), APKs (apk_data_file and shell_data_file where the latter is for test apks in
# /data/local/tmp), instance.img (app_data_file, privapp_data_file and aiseal_data_file), and
# microdroid vendor image (vendor_microdroid_file).
# Allow crosvm to read the instance image of the service VM saved in apex_virt_data_file.
# Note that the open permission is not given as the files are passed as file descriptors.
allow crosvm_domain {
  virtualizationservice_data_file
  staging_data_file
  aiseal_data_file
  apk_data_file
  app_data_file
  privapp_data_file
  apex_compos_data_file
  apex_virt_data_file
  shell_data_file
  vendor_microdroid_file
  vendor_vm_file
  vendor_vm_data_file
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `vm_data_file')
}:file { getattr read ioctl lock };

# Updated APEXes are accessed via apex_dm_device
allow crosvm_domain block_device:dir search;
allow crosvm_domain apex_dm_device:blk_file r_file_perms;

# Allow searching the directory where the composite disk images are.
allow crosvm_domain {
    virtualizationservice_data_file
    is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `vm_data_file')
}:dir search;

# When running a VM as root we get spurious capability denials.
# Suppress them.
userdebug_or_eng(`
  dontaudit crosvm_domain self:capability ipc_lock;
')

# Allow crosvm to tune for performance.
# Allow crosvm to use ipc_owner capability to enable guest-ffa for pVMs.
# Note: the crosvm itself doesn't have the ipc_owner capability, but will only inherit it iff
# the "pVM owner" process (the process that is using AVF APIs to start a pVM has the capability.
allow crosvm_domain self:global_capability_class_set { ipc_owner sys_nice };

# Let crosvm access its control socket as created by VS.
#   read, write, getattr: listener socket polling
#   accept: listener socket accepting new connection
# Note that the open permission is not given as the socket is passed by FD.
allow crosvm_domain {
  virtualizationmanager_domain
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `early_virtmgr_domain')
}:unix_stream_socket { accept read write getattr getopt };

# Let crosvm open test artifacts under /data/local/tmp with file path. (e.g. custom pvmfw.img)
userdebug_or_eng(`
  allow crosvm_domain shell_data_file:dir search;
  allow crosvm_domain shell_data_file:file open;
')

# The instance image and the composite image should be writable as well because they could represent
# mutable disks.
allow crosvm_domain {
  virtualizationservice_data_file
  aiseal_data_file
  app_data_file
  privapp_data_file
  apex_compos_data_file
  apex_virt_data_file
  vendor_vm_data_file
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `vm_data_file')
}:file write;

# Allow crosvm to pipe console log to shell or app which could be the owner of a VM.
allow crosvm_domain adbd:fd use;
allow crosvm_domain adbd:unix_stream_socket { read write };
allow crosvm_domain devpts:chr_file { read write getattr ioctl };

is_flag_enabled(RELEASE_AVF_SUPPORT_CUSTOM_VM_WITH_PARAVIRTUALIZED_DEVICES, `
  # Allow crosvm to draw screen in the surface
  allow crosvm_domain device:dir { read open };
  allow crosvm_domain same_process_hal_file:file { read open getattr map execute };
  allow crosvm_domain hal_graphics_allocator:fd use;
  allow crosvm_domain hal_graphics_allocator_server:binder call;
  allow crosvm_domain surfaceflinger:fd use;
  # non-vendor domains are handled by virtualizationservice_use macro
  gpu_sphal_use(crosvm_vendor)

  # To provide display service to an app to get surface.
  # TODO(b/332677707): remove them when display service uses binder RPC.
  allow crosvm_domain vmlauncher_app:binder { transfer call };
  allow crosvm_domain servicemanager:binder { call transfer };
  allow crosvm_domain virtualization_service:service_manager find;
  allow crosvm_domain virtualizationservice:binder { call transfer };
  # non-vendor domains are handled by virtualizationservice_use macro
  hal_client_domain(crosvm_vendor, hal_graphics_allocator)

  allow crosvm_domain mnt_user_file:dir search;

  allow crosvm_domain hal_graphics_composer:fd use;
  # Allow crosvm to create unix socket for vhost-user-fs
  allow crosvm_domain virtualizationservice_data_file:dir { add_name write remove_name };
  allow crosvm_domain virtualizationservice_data_file:sock_file { create write unlink };

  # for gfxstream with udmabuf
  allow crosvm_domain udmabuf_device:chr_file { open read write ioctl };

  # ASurfaceTransaction_setBuffer for gfxstream
  binder_call(crosvm_domain, surfaceflinger)
  allow crosvm_domain surfaceflinger_service:service_manager find;
')

# crosvm tries to use netlink sockets as part its APCI implementation, but we don't need it for AVF (b/228077254)
dontaudit crosvm_domain self:netlink_generic_socket create_socket_perms_no_ioctl;

# crosvm can write files in /data/local/tmp which are usually used for instance.img and logging by
# compliance tests and demo apps. Write access to instance.img is particularily important because
# the VM has to initialize the disk image on its first boot. Note that open access is still not
# granted because the files are expected to be opened by the owner of the VM (apps or shell in case
# when the vm is created by the `vm` tool) and handed over to crosvm as FD.
allow crosvm_domain shell_data_file:file write;

# crosvm tries to read serial device, including the write-only pipe from virtualizationmanager_domain (to
# forward console/log to the host logcat).
# crosvm only needs write permission, so dontaudit read
dontaudit crosvm_domain {
  virtualizationmanager_domain
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `early_virtmgr_domain')
}:fifo_file { read getattr };

# Required for crosvm to start gdb-server to enable debugging of guest kernel.
allow crosvm_domain self:tcp_socket { bind create read setopt write accept listen };
allow crosvm_domain port:tcp_socket name_bind;
allow crosvm_domain adbd:unix_stream_socket ioctl;
allow crosvm_domain node:tcp_socket node_bind;

# Allow crosvm to interact to VFIO device
allow crosvm_domain vfio_device:chr_file rw_file_perms;
allow crosvm_domain vfio_device:dir r_dir_perms;

# Allow crosvm to access VM DTBO via a file created by virtualizationmanager_domain.
allow crosvm_domain virtualizationservice_data_file:file read;

is_flag_enabled(RELEASE_AVF_ENABLE_NETWORK, `
    # Allow crosvm to deal with file descriptors of TAP interfaces.
    allow crosvm_domain tun_device:chr_file rw_file_perms;
    allowxperm crosvm_domain tun_device:chr_file ioctl { TUNGETIFF TUNSETOFFLOAD TUNSETVNETHDRSZ };
    allow crosvm_domain self:udp_socket create_socket_perms;
    allowxperm crosvm_domain self:udp_socket ioctl SIOCGIFMTU;
    allow crosvm_domain vmnic:fd use;
')

# Early VMs may print messages to kmsg_debug_device.
allow crosvm_domain kmsg_debug_device:chr_file w_file_perms;

# Allow crosvm to read /data/nativetest for VTS
r_dir_file(crosvm_domain, nativetest_data_file)

# Don't allow crosvm to open files that it doesn't own.
# This is important because a malicious application could try to start a VM with a composite disk
# image referring by name to files which it doesn't have permission to open, trying to get crosvm to
# open them on its behalf. By preventing crosvm from opening any other files we prevent this
# potential privilege escalation. See http://b/192453819 for more discussion.
neverallow crosvm_domain {
  virtualizationservice_data_file
  staging_data_file
  aiseal_data_file
  apk_data_file
  app_data_file
  privapp_data_file
  is_flag_enabled(RELEASE_UNLOCKED_STORAGE_API, `storage_area_content_file')
  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `vm_data_file')
  userdebug_or_eng(`-shell_data_file')
}:file open;

# Don't allow crosvm to have access to ordinary vendor files that are not for VMs.
full_treble_only(`
  neverallow crosvm_domain {
    vendor_file_type
    -vendor_vm_file
    -vendor_vm_data_file
    # These types are not required for crosvm, but the access is granted to globally in domain.te
    # thus should be exempted here.
    -vendor_cgroup_desc_file
    -vendor_configs_file
    -vendor_microdroid_file
    -vndk_sp_file
    -vendor_task_profiles_file
    -same_process_hal_file
  }:file *;
')

# Only allow crosvm to read app data files for clients that can start
# VMs. Note that the use of app data files is further restricted
# inside the virtualizationservice by checking the label of all disk
# image files.
neverallow crosvm_domain {
  app_data_file_type
  -app_data_file
  -privapp_data_file
  -shell_data_file
}:file read;

# Only virtualizationmanager_domain can run crosvm
# Allow vmlauncher app to launch crosvm for virtiofs
neverallow {
  domain
  -crosvm_domain
  -crosvm_vu_fs
  -crosvm_vu_snd
  -virtualizationmanager_domain
  -vmlauncher_app
  userdebug_or_eng(`-overlay_remounter')

  is_flag_enabled(RELEASE_AVF_ENABLE_EARLY_VM, `-early_virtmgr_domain')
} crosvm_exec:file no_x_file_perms;

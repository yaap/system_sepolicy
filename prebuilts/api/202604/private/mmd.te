# mmd memory management daemon
type mmd, domain;
typeattribute mmd coredomain;
type mmd_exec, system_file_type, exec_type, file_type;

init_daemon_domain(mmd)

# Set mmd.enabled_aconfig and zram backing device size.
set_prop(mmd, mmd_shared_status_prop)
set_prop(mmd, mmd_status_prop)
get_prop(mmd, mmd_prop)
get_prop(mmd, mmd_config_prop)
get_prop(mmd, device_config_mmd_native_prop)

# mmd binder setup
add_service(mmd, mmd_service)
binder_use(mmd)

# Read /proc/swaps to check if swap is active.
allow mmd proc_swaps:file r_file_perms;

# zram sysfs access
allow mmd sysfs_zram:dir search;
allow mmd sysfs_zram:file rw_file_perms;

# procfs
allow mmd proc_meminfo:file r_file_perms;

# Access to zram block device. The zram[0-9]* file itself
# can be either swap_block_device or ram_device.
allow mmd block_device:dir search;
allow mmd { ram_device swap_block_device }:blk_file rw_file_perms;

# Allow mmd to write to statsd socket.
unix_socket_send(mmd, statsdw, statsd)
# Allow mmd to interact with statsd binder calls for pulled atoms.
allow mmd stats_service:service_manager find;
allow mmd statsmanager_service:service_manager find;
binder_call(mmd, statsd)

# Allow mmd to send dump info to dumpstate.
allow mmd dumpstate:fd use;
allow mmd dumpstate:fifo_file { getattr write };

# Allow mmd to issue the zram ioctls, and make sure that
# nothing else can use them.
allowxperm mmd { ram_device swap_block_device }:blk_file ioctl {
    ZRAM_ANDROID_IOC_VERSION
    ZRAM_ANDROID_IOC_PROCESS_WRITEBACK_RANGE
    ZRAM_ANDROID_IOC_PROCESS_PREFETCH
};
neverallowxperm { domain -mmd } { ram_device swap_block_device }:blk_file ioctl {
    ZRAM_ANDROID_IOC_VERSION
    ZRAM_ANDROID_IOC_PROCESS_WRITEBACK_RANGE
    ZRAM_ANDROID_IOC_PROCESS_PREFETCH
};
neverallowxperm domain { ram_device swap_block_device }:blk_file ioctl ZRAM_ANDROID_IOC_PROCESS_WRITEBACK;

# Necessary for zram writeback ioctl.
allow mmd self:capability sys_nice;

# Allow mmd to use pidfds received from system_server.
allow mmd system_server:fd use;

# Zram per-process writeback requires write access for files mapped
# into the target process that are swappable (i.e. shmem). As of
# kernel 6.17, this check is performed by can_do_file_pageout() in
# the kernel.
#
# Shmem based files include tmpfs as well as some GPU objects
# accessed via mappings of a GPU device fd.
allow mmd zygote_tmpfs:file write;
allow mmd appdomain_tmpfs:file write;
allow mmd system_server_tmpfs:file write;
allow mmd gpu_device:chr_file write;
allow mmd zygote:memfd_file write;
allow mmd appdomain:memfd_file write;
allow mmd system_server:memfd_file write;
allow mmd gpu_device:memfd_file write;

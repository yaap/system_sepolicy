type hal_gatekeeper_default, domain;
hal_server_domain(hal_gatekeeper_default, hal_gatekeeper)

type hal_gatekeeper_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_gatekeeper_default);

allow hal_gatekeeper gatekeeper_vendor_data_file:dir create_dir_perms;
allow hal_gatekeeper gatekeeper_vendor_data_file:dir rw_dir_perms;
allow hal_gatekeeper gatekeeper_vendor_data_file:file { create_file_perms };
